# 公开行情无需任何凭证。不需要提供 Variational 钱包私钥。
# 本文件仅说明未来实盘适配器所需字段；当前实盘仍禁用。
VARIATIONAL_WALLET_ADDRESS=

# Lighter 官方 SDK 使用专用 API 私钥，不使用旧 HMAC API_SECRET。
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=5
LIGHTER_API_PRIVATE_KEY=

# Lighter Robinhood Chain is a separate deployment and account. Its API
# endpoint and signing domain are handled by the execution adapter.
LIGHTER_RH_ACCOUNT_INDEX=
LIGHTER_RH_API_KEY_INDEX=
LIGHTER_RH_API_PRIVATE_KEY=

# StandX BSC wallet authentication. The private key is kept local and is
# never returned by the dashboard API.
STANDX_WALLET_ADDRESS=
STANDX_WALLET_PRIVATE_KEY=
STANDX_CHAIN=bsc

# Arcus Ed25519 API credentials. The dashboard verifies them read-only first;
# live submission remains behind the explicit global live switch.
ARCUS_WALLET_ADDRESS=
ARCUS_ACCOUNT_INDEX=0
ARCUS_API_SIGNING_KEY=

# 可选：按本机实际代理端口配置
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
